type Unit = "px" | "%" | "em" | "rem";

type SectionUI = {
  // Layout
  layout?: {
    contentWidth?: "boxed" | "full";
    contentHeight?: "auto" | "min-60vh" | "full";
    columnGap?: number;
    alignItems?: "start" | "center" | "end" | "stretch";
    justify?: "start" | "center" | "end" | "between";
    stretchSection?: boolean;
    overflowHidden?: boolean;
  };
  // Design
  design?: {
    background?: string;            // color or image URL
    backgroundSize?: "cover" | "contain" | "auto";
    backgroundPosition?: "center" | "top" | "bottom" | "left" | "right";
    filterBlur?: number;            // px
    filterBrightness?: number;      // %
    filterContrast?: number;        // %
    overlayColor?: string;
    overlayOpacity?: number;        // 0-1
    borderColor?: string;
    borderWidth?: number;
    borderRadius?: number;
    typography?: {
      fontSize?: number;            // px
      lineHeight?: number;          // unitless
      color?: string;
      align?: "left" | "center" | "right";
    };
  };
  // Advanced
  advanced?: {
    spacing?: {
      unit?: Unit;
      marginTop?: number; marginRight?: number; marginBottom?: number; marginLeft?: number;
      paddingTop?: number; paddingRight?: number; paddingBottom?: number; paddingLeft?: number;
    };
    position?: {
      type?: "static" | "relative" | "absolute" | "sticky";
      top?: number | null; right?: number | null; bottom?: number | null; left?: number | null;
      zIndex?: number | "auto";
    };
    transform?: {
      translateX?: number; translateY?: number; // px
      scale?: number; rotate?: number;          // deg
      origin?: "center" | "top" | "bottom" | "left" | "right";
    };
    visibility?: {
      hideOnMobile?: boolean; hideOnTablet?: boolean; hideOnDesktop?: boolean;
    };
    animation?: {
      entrance?: "none" | "fade" | "slide-up" | "slide-right" | "zoom-in";
    };
    attributes?: { id?: string; className?: string; dataAttrs?: string }; // e.g. "data-test=hero;data-foo=bar"
    conditions?: { enabled?: boolean; js?: string }; // return truthy to render
  };
};

