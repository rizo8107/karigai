// ——— runtime helpers
function parseDataAttrs(s?: string) {
  const attrs: Record<string,string> = {};
  if (!s) return attrs;
  s.split(";").map(x => x.trim()).filter(Boolean).forEach(pair => {
    const [k,v] = pair.split("=").map(y => (y ?? "").trim());
    if (k) attrs[k] = v ?? "";
  });
  return attrs;
}

function sectionWrapperProps(ui?: SectionUI): {
  style: CSSProperties;
  className: string;
  attrs: Record<string, any>;
  shouldRender: boolean;
} {
  const style: CSSProperties = {};
  const cls: string[] = [];
  const attrs: Record<string, any> = {};

  // Layout
  const L = ui?.layout;
  if (L?.contentHeight === "min-60vh") style.minHeight = "60vh";
  if (L?.contentHeight === "full") style.minHeight = "100vh";
  if (L?.columnGap != null) style.gap = `${L.columnGap}px`;
  if (L?.alignItems) style.alignItems = L.alignItems === "start" ? "flex-start" : L.alignItems === "end" ? "flex-end" : L.alignItems;
  if (L?.justify) style.justifyContent = ({start:"flex-start",center:"center",end:"flex-end",between:"space-between"} as any)[L.justify];
  if (L?.stretchSection) style.width = "100%";
  if (L?.overflowHidden) style.overflow = "hidden";

  // Design
  const D = ui?.design;
  if (D?.background) {
    if (D.background.startsWith("#") || D.background.startsWith("rgb")) {
      style.background = D.background;
    } else {
      style.backgroundImage = `url(${D.background})`;
    }
  }
  if (D?.backgroundSize) style.backgroundSize = D.backgroundSize;
  if (D?.backgroundPosition) style.backgroundPosition = D.backgroundPosition;
  if (D?.borderColor) style.borderColor = D.borderColor, style.borderStyle = "solid";
  if (D?.borderWidth != null) style.borderWidth = `${D.borderWidth}px`;
  if (D?.borderRadius != null) style.borderRadius = `${D.borderRadius}px`;
  if (D?.typography?.fontSize) style.fontSize = `${D.typography.fontSize}px`;
  if (D?.typography?.lineHeight) style.lineHeight = D.typography.lineHeight as number;
  if (D?.typography?.color) style.color = D.typography.color;
  if (D?.typography?.align) style.textAlign = D.typography.align as any;

  // Filters
  const filters: string[] = [];
  if (D?.filterBlur) filters.push(`blur(${D.filterBlur}px)`);
  if (D?.filterBrightness && D.filterBrightness !== 100) filters.push(`brightness(${D.filterBrightness}%)`);
  if (D?.filterContrast && D.filterContrast !== 100) filters.push(`contrast(${D.filterContrast}%)`);
  if (filters.length) style.filter = filters.join(" ");

  // Advanced
  const A = ui?.advanced;

  // spacing
  const U = A?.spacing?.unit ?? "px";
  const u = (n?: number) => (n == null ? undefined : `${n}${U}`);
  if (A?.spacing) {
    style.marginTop = u(A.spacing.marginTop);
    style.marginRight = u(A.spacing.marginRight);
    style.marginBottom = u(A.spacing.marginBottom);
    style.marginLeft = u(A.spacing.marginLeft);
    style.paddingTop = u(A.spacing.paddingTop);
    style.paddingRight = u(A.spacing.paddingRight);
    style.paddingBottom = u(A.spacing.paddingBottom);
    style.paddingLeft = u(A.spacing.paddingLeft);
  }

  // position
  if (A?.position?.type) style.position = A.position.type as any;
  const has = (v: any) => v !== null && v !== undefined;
  if (has(A?.position?.top))    style.top = `${A?.position?.top}px`;
  if (has(A?.position?.right))  style.right = `${A?.position?.right}px`;
  if (has(A?.position?.bottom)) style.bottom = `${A?.position?.bottom}px`;
  if (has(A?.position?.left))   style.left = `${A?.position?.left}px`;
  if (A?.position?.zIndex !== undefined) style.zIndex = A.position.zIndex as any;

  // transform
  const tr: string[] = [];
  if (A?.transform?.translateX) tr.push(`translateX(${A.transform.translateX}px)`);
  if (A?.transform?.translateY) tr.push(`translateY(${A.transform.translateY}px)`);
  if (A?.transform?.scale && A.transform.scale !== 1) tr.push(`scale(${A.transform.scale})`);
  if (A?.transform?.rotate) tr.push(`rotate(${A.transform.rotate}deg)`);
  if (tr.length) style.transform = tr.join(" ");
  if (A?.transform?.origin) style.transformOrigin = A.transform.origin;

  // visibility
  if (A?.visibility?.hideOnMobile)  cls.push("hidden", "sm:block");
  if (A?.visibility?.hideOnTablet)  cls.push("sm:hidden", "lg:block");
  if (A?.visibility?.hideOnDesktop) cls.push("lg:hidden");

  // animation (basic utility classes — replace with your own)
  switch (A?.animation?.entrance) {
    case "fade":      cls.push("animate-fade-in"); break;
    case "slide-up":  cls.push("animate-slide-up"); break;
    case "slide-right": cls.push("animate-slide-right"); break;
    case "zoom-in":   cls.push("animate-zoom-in"); break;
  }

  // attributes
  if (A?.attributes?.id) attrs.id = A.attributes.id;
  if (A?.attributes?.className) cls.push(A.attributes.className);
  Object.assign(attrs, parseDataAttrs(A?.attributes?.dataAttrs));

  // conditions
  const shouldRender = A?.conditions?.enabled
    ? !!(function() { try { return eval(A?.conditions?.js || "true"); } catch { return false; } })()
    : true;

  // container (boxed vs full)
  if ((ui?.layout?.contentWidth ?? "full") === "boxed") {
    cls.push("konipai-container");
  }

  return { style, className: cls.join(" "), attrs, shouldRender };
}
