# PocketBase Configuration
VITE_POCKETBASE_URL=https://pocketbase.karigai.com

# Appwrite Configuration
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id

# Razorpay Configuration
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
VITE_RAZORPAY_KEY_SECRET=your_razorpay_key_secret
VITE_RAZORPAY_PROXY_URL=https://your-proxy-server.com/razorpay
VITE_RAZORPAY_PROXY_KEY=your_proxy_key

# CRM Integration
VITE_CRM_ORDER_ENDPOINT=https://your-crm-endpoint.com/orders
VITE_CRM_VERIFY_ENDPOINT=https://your-crm-endpoint.com/verify

# n8n Webhook Configuration
VITE_N8N_WEBHOOK_URL=https://n8n.karigai.com/webhook/orders
VITE_N8N_AUTH_USERNAME=your_webhook_username
VITE_N8N_AUTH_PASSWORD=your_webhook_password

# Site Configuration
VITE_SITE_URL=https://karigai.com
VITE_ENABLE_GOOGLE_AUTH=false
VITE_LOGO_PATH=/karigai-logo.webp
