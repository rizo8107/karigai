# Karigai Environment Configuration

# Environment Type
NODE_ENV=development # development, production, staging

# Backend URL Configuration
VITE_POCKETBASE_URL=http://localhost:8090
VITE_API_URL=http://localhost:3000

# Payment Gateway - Razorpay
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here
VITE_RAZORPAY_CURRENCY=INR
VITE_RAZORPAY_LOCALE=en

# Order Processing Backend
VITE_CREATE_ORDER_ENDPOINT=https://crm-supabase.7za6uc.easypanel.host/functions/v1/create-order-karigai
VITE_VERIFY_PAYMENT_ENDPOINT=https://crm-supabase.7za6uc.easypanel.host/functions/v1/verify-payment-karigai

# Analytics Configuration
# Set to 'true' to enable analytics in development (default: enabled only in production)
VITE_ENABLE_ANALYTICS=false

# Google Analytics
VITE_GA_MEASUREMENT_ID=

# Google Tag Manager
VITE_GTM_CONTAINER_ID=

# Facebook Pixel
VITE_FB_PIXEL_ID=

# Microsoft Clarity
VITE_CLARITY_PROJECT_ID=

# Site Configuration
VITE_SITE_NAME=Karigai
VITE_SITE_URL=https://karigai.com
VITE_SITE_LOGO=/path/to/logo.svg
VITE_DEFAULT_CURRENCY_SYMBOL=₹
VITE_CONTACT_EMAIL=support@karigai.com
VITE_CONTACT_PHONE=+91 9486054899
